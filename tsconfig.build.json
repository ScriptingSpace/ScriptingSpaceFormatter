{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Flatten output: src/index.ts → lib/index.js (matches the "main" /
        // "exports" entry points in package.json)
        "rootDir": "src"
    },
    // Library build config — emits JS + .d.ts for src/index.ts (the public
    // barrel) and everything it reaches into lib/. App-only code (main.tsx,
    // app.css side-effect import), root-level vite/vitest configs and tests
    // are excluded so the published surface is exactly the package's exports.
    "exclude": [
        "node_modules",
        "src/main.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "index.ts",
        // bin/ holds the standalone CLI/app entry (bin/formatter.js,
        // bin/scaffold.js — plain JS, shipped as-is via package.json "files").
        // It must NOT be compiled into lib/: with rootDir "src" these files
        // fall outside rootDir (TS6059) and tsc would try to emit them back
        // onto themselves (TS5055 "would overwrite input file") — the GitHub
        // Actions build:lib failure. They are runtime artifacts, not sources.
        "bin/**/*",
        "**/dist/*",
        "**/lib/*"
    ]
}
